{
    "name": "hydina/defina-moon",
    "description": "A full-featured PHP engine for creating dynamic web interfaces using Yii",
    "keywords": [
        "yii",
        "php",
        "framework",
        "hydina",
        "livewire",
        "dynamic"
    ],
    "type": "yii2-extension",
    "license": "GPL-3.0 license",
    "authors": [
        {
            "name": "Raymond Turchin",
            "email": "hydina@defina.ee",
            "homepage": "https://hydina.netlify.app",
			"role": "Creator"
        }
    ],
    "support": {
        "issues": "https://github.com/hydina/definamoon/issues",
        "source": "https://github.com/hydina/definamoon"
    },
    "require": {
        "php": "^8.1",
        "yiisoft/yii2": "^2.0.45"
    },
    "require-dev": {
        "livewire/livewire": "^3.8|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Hydina\\DefinaMoon\\": ""
        }
    },
    "extra": {
        "bootstrap": "Hydina\\DefinaMoon\\Bootstrap"
    }
}